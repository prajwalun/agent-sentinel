# =============================================================================
# Agent Sentinel — Environment Variables
# =============================================================================
# Copy to .env:   cp .env.example .env
#
# Setup order:
#   1. Create .env from this file
#   2. Add OPENAI_API_KEY when you want AI analysis on the dashboard
#   3. After signup, add SENTINEL_API_KEY (copy from dashboard)
# =============================================================================

# --- LLM Provider (for AI analysis on dashboard) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Web Research (optional — threat intelligence) ---
EXA_API_KEY=your_exa_api_key_here

# --- Observability (optional — Weights & Biases tracing) ---
WANDB_API_KEY=your_wandb_api_key_here

# --- Intelligence Backend ---
JWT_SECRET=change_me_to_a_random_secret
ADMIN_SECRET=change_me_admin_secret

# --- SDK → Backend (add SENTINEL_API_KEY after signup) ---
SENTINEL_API_URL=http://localhost:8001
SENTINEL_API_KEY=your_api_key_from_dashboard_signup

# --- Dashboard Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8001
