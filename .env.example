# =============================================================================
# Agent Sentinel — Environment Variables
# =============================================================================
# Copy to .env and fill in your values:   cp .env.example .env
# =============================================================================

# --- LLM Provider (required for AI analysis) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Web Research (optional — enriches threat intelligence) ---
EXA_API_KEY=your_exa_api_key_here

# --- Observability (optional — Weights & Biases / Weave tracing) ---
WANDB_API_KEY=your_wandb_api_key_here

# --- Intelligence Backend ---
JWT_SECRET=change_me_to_a_random_secret
ADMIN_SECRET=change_me_admin_secret

# --- SDK → Backend connection (optional — for live event streaming) ---
SENTINEL_API_URL=http://localhost:8001
SENTINEL_API_KEY=your_api_key_from_dashboard_settings

# --- Dashboard Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8001
