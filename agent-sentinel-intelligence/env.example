# Agent Sentinel Intelligence Layer - Environment Configuration

# LLM Providers (at least one required)
# OpenAI API Key - Required for OpenAI models
OPENAI_API_KEY=your_openai_api_key_here

# Google API Key - Required for Google Gemini models
GOOGLE_API_KEY=your_google_api_key_here

# Web Research (optional)
# Exa.ai API Key - Required for web research capabilities
EXA_API_KEY=your_exa_api_key_here

# Tracing & Monitoring (optional)
# Weights & Biases API Key - Required for tracing and monitoring
WANDB_API_KEY=your_wandb_api_key_here

# Configuration Overrides (optional)
# These can override default configuration values

# LLM Configuration
# LLM_PROVIDER=openai  # or google
# LLM_MODEL=gpt-4o     # or gemini-1.5-flash
# LLM_TEMPERATURE=0.1

# Tracing Configuration
# TRACING_ENABLED=true
# TRACING_PROVIDER=weave  # or wandb or none
# TRACING_PROJECT_NAME=agent-sentinel-intelligence

# Research Configuration
# RESEARCH_ENABLED=true
# RESEARCH_MAX_QUERIES=5
# RESEARCH_TIMEOUT=30

# Output Configuration
# OUTPUT_GENERATE_TEXT=true
# OUTPUT_GENERATE_PDF=true
# OUTPUT_DIRECTORY=./reports 